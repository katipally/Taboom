# Docker Compose settings. Copy to .env; keep private values out of Git.
# Recreate with "docker compose up -d" after changing environment settings.
# For the full field reference, see README.md -> Configuration and personas.

# Published image tag; --build builds the checked-out source instead.
TABOOM_VERSION=latest

# One selected persona per container; file is personas/<name>.toml in the data volume.
TABOOM_PERSONA=default

# Host ports and independent bind addresses.
TABOOM_MCP_PORT=3456
TABOOM_VIEW_PORT=6080
TABOOM_MCP_PUBLISH=127.0.0.1
TABOOM_VIEW_PUBLISH=127.0.0.1

# Configure named tokens before exposing MCP beyond loopback.
# Format: name=token,name2=token2. Each name is a separate lease identity.
# Without tokens, clients share the anonymous identity.
# TABOOM_MCP_TOKENS=agent-a=replace-with-private-token,agent-b=replace-with-another-token

# These URLs derive from the local host ports unless overridden.
# MCP/replays and noVNC may use separate reverse proxies.
# TABOOM_PUBLIC_URL=https://taboom.example.com
# Preserve view_only=1 in the watch URL; the control link removes it.
# TABOOM_VIEW_URL=https://view.example.com/vnc.html?autoconnect=1&resize=scale&view_only=1

# Extra exact Origin values for browser-hosted MCP clients, comma-separated.
# TABOOM_MCP_ALLOWED_ORIGINS=https://agent.example.com

# Route verification interval in seconds (default 300, minimum 30).
# TABOOM_ROUTE_RECHECK_S=300

# Optional proxy credential passphrase path inside the container.
# A Compose secret/mount must supply this file; setting the path alone does not mount it.
# This resolves proxy credentials, not the daemon's MCP typing-vault unlock state.
# TABOOM_VAULT_PASSPHRASE_FILE=/run/secrets/taboom_vault_passphrase

# Optional recording retention target checked at session start (not a hard disk quota).
# Unset means recordings are retained. Oldest finished sessions are pruned when enabled.
# TABOOM_RECORDINGS_MAX_GB=5

# Optional real input trace path inside the container.
# Secret keystroke tracing pauses, then resumes; later traces/visual artifacts are not redacted.
# VINPUT_TRACE=/home/taboom/.taboom/logs/input-trace.jsonl

# Chrome's declared cpus value must match its visible CPU set.
# Use host CPU IDs actually available on your Docker daemon.
# TABOOM_CPUSET=0-3

# Browser engines included at image build time. Default is Chrome.
# Fortress requires a native AMD64 builder/runtime/host and a Fortress-selected persona.
# Rebuild after changing TABOOM_ENGINES; publish workflow images contain Chrome.
# TABOOM_ENGINES=chrome,fortress
# TABOOM_HOST_ARCH=amd64

# Manual gauntlet commit metadata override, useful for worktree .git files.
# TABOOM_GIT_COMMIT=<full-commit-sha>

# Low-level daemon overrides such as TABOOM_MAX_EDGE, TABOOM_FILES_DIR and
# TABOOM_ROUTE_ECHO_URL are not forwarded by the supplied Compose file.
# Add those under the service's environment if needed.
