# Use a published image tag, or leave "latest" for the newest stable release.
TABOOM_VERSION=latest

# Keep MCP and the live view on localhost by default.
TABOOM_MCP_PUBLISH=127.0.0.1
TABOOM_VIEW_PUBLISH=127.0.0.1

# For network access, set TABOOM_MCP_PUBLISH=0.0.0.0 and configure named bearer tokens.
# Example format: TABOOM_MCP_TOKENS=claude=replace-me,cursor=replace-me-too
# Do not commit real tokens.
# TABOOM_PUBLIC_URL=https://taboom.example.com

# Optional exact Origin values for browser-hosted MCP clients.
# Example: TABOOM_MCP_ALLOWED_ORIGINS=https://agent.example.com

# Optional host ports.
# TABOOM_MCP_PORT=3456
# TABOOM_VIEW_PORT=6080

# If you publish the live view through a private host or reverse proxy, set its browser-visible URL.
# TABOOM_VIEW_URL=https://taboom.example.com/vnc.html?autoconnect=1&resize=scale&view_only=1
